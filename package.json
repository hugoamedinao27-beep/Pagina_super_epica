{
  "name": "tienda-super-wai",
  "version": "1.0.0",
  "description": "Sistema de Registro de Asistencia - Tienda Super Wai",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node --watch main.js",
    "init-db": "node database/init.js",
    "test": "node --test --test-concurrency=1 test/unit/validation.test.js test/unit/business-time.test.js test/integration/api.test.js test/concurrency/attendance.test.js",
    "test:unit": "node --test test/unit/validation.test.js test/unit/business-time.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/api.test.js",
    "test:concurrency": "node --test --test-concurrency=1 test/concurrency/attendance.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 test/unit/validation.test.js test/unit/business-time.test.js test/integration/api.test.js test/concurrency/attendance.test.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "mysql2": "^3.6.5"
  }
}
